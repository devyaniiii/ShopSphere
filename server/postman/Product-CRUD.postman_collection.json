{
  "info": {
    "name": "ShopSphere - Product CRUD APIs",
    "description": "Postman collection for testing Product CRUD APIs with response assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Product (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rose Plant\",\n  \"description\": \"A beautiful rose plant\",\n  \"price\": 250,\n  \"stock\": 10,\n  \"category\": \"{{categoryId}}\",\n  \"images\": [],\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has success envelope', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data).to.be.an('object');",
              "    pm.expect(json.data._id).to.be.a('string');",
              "});",
              "const json = pm.response.json();",
              "if (json.data && json.data._id) {",
              "    pm.collectionVariables.set('productId', json.data._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Products (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products?page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains items and pagination', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data.items).to.be.an('array');",
              "    pm.expect(json.data.pagination.page).to.eql(1);",
              "    pm.expect(json.data.pagination.limit).to.eql(10);",
              "    pm.expect(json.data.pagination).to.have.property('totalItems');",
              "    pm.expect(json.data.pagination).to.have.property('totalPages');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains the requested product', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data._id).to.eql(pm.collectionVariables.get('productId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Product (Admin)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 300,\n  \"stock\": 15\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Product price and stock are updated', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data.price).to.eql(300);",
              "    pm.expect(json.data.stock).to.eql(15);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Product (Admin)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
